-- Seervision Trigger Mapper
-- Maps Seervision/VisionSuite zone-triggered events to control changes on
-- other named components in the design.

-- Information block for the plugin
BuildVersion = "0.0.0.14" -- dev build; bump on every change until the 1.0 release
PluginInfo = {
  Name = "QSC~Seervision Trigger Mapper v".. BuildVersion, -- preferred format is "manufacturer~plugin name version"
  Version = BuildVersion,
  Id = "3e5605bd-9c7f-4614-84ec-e9ccb36b4370", -- generated by PLUGCC on first build
  Author = "QSC",
  Description = "Maps Seervision/VisionSuite zone-triggered events to control changes on other named components in the design.",
}

-- Define the color of the plugin object in the design
function GetColor(props)
  return { 51, 122, 183 }
end

-- The name that will initially display when dragged into a design
function GetPrettyName(props)
  return "Seervision Trigger Mapper v" .. PluginInfo.Version
end

-- Define User configurable Properties of the plugin
function GetProperties()
  local props = {}
  table.insert(props,{Name = "Rule Count",Type = "integer",Min = 1,Max = 32,Value = 4})
  return props
end

-- Optional function to update available properties when properties are altered by the user
function RectifyProperties(props)
  -- Rule Count is clamped natively by its Min/Max (see GetProperties); no
  -- dynamic show/hide of properties is needed yet.
  return props
end

-- Plugin has two pages: the rule list, and a component/control inspector used
-- to discover Seervision's real control names against a live design.
PageNames = { "Rules", "Inspector" }
function GetPages(props)
  local pages = {}
  for _,value in ipairs(PageNames) do
    table.insert(pages, {name = value})
  end
  return pages
end

-- Defines the Controls used within the plugin
function GetControls(props)
  local ctrls = {}
  table.insert(ctrls,{Name = "sv_component",ControlType = "Text",DefaultValue = "none",Count = 1})
  table.insert(ctrls,{Name = "inspect_component",ControlType = "Text",DefaultValue = "none",Count = 1})
  table.insert(ctrls,{Name = "inspect_output",ControlType = "Text",DefaultValue = "",Count = 1})
  
  for i = 1,props["Rule Count"].Value do
    table.insert(ctrls,{Name = "rule_enable_"..i,ControlType = "Button",ButtonType = "Toggle",Count = 1})
    table.insert(ctrls,{Name = "rule_trigger_"..i,ControlType = "Text",DefaultValue = "none",Count = 1})
    table.insert(ctrls,{Name = "rule_target_component_"..i,ControlType = "Text",DefaultValue = "none",Count = 1})
    table.insert(ctrls,{Name = "rule_target_control_"..i,ControlType = "Text",DefaultValue = "none",Count = 1})
    table.insert(ctrls,{Name = "rule_target_property_"..i,ControlType = "Text",DefaultValue = "Value",Count = 1})
    table.insert(ctrls,{Name = "rule_target_value_bool_"..i,ControlType = "Text",DefaultValue = "false",Count = 1})
    table.insert(ctrls,{Name = "rule_target_value_num_"..i,ControlType = "Text",DefaultValue = "0",Count = 1})
    table.insert(ctrls,{Name = "rule_target_value_str_"..i,ControlType = "Text",DefaultValue = "",Count = 1})
    table.insert(ctrls,{Name = "rule_status_"..i,ControlType = "Indicator",IndicatorType = "Status",DefaultValue = 4,Count = 1})
    table.insert(ctrls,{Name = "rule_clear_"..i,ControlType = "Button",ButtonType = "Trigger",Count = 1})
  end
  return ctrls
end

-- Layout of controls and graphics for the plugin UI to display
function GetControlLayout(props)
  local layout = {}
  local graphics = {}
  local CurrentPage = PageNames[props["page_index"].Value]
  local White  = {255,255,255}
  local Black  = {0,0,0}
  local Text   = {51,51,51}
  local Clear  = {255,255,255,0}
  local Grey   = {230,230,230}
  local Blue   = {5,97,165}
  local Border = {200,200,200}
  
  if CurrentPage == "Rules" then
    local panelWidth = 750
    local ruleCount = props["Rule Count"].Value
  
    local bodyTop = 30
    local toolbarY = bodyTop + 8
    local dividerY = toolbarY + 30
    local headerY = dividerY + 8
    local rowY = headerY + 16
    local rowH = 24
    local panelBottom = rowY + ruleCount*rowH + 10
    local panelHeight = panelBottom - bodyTop
  
    table.insert(graphics,{Type = "Header",Text = "Seervision Trigger Mapper",Color = Blue,Font = "Roboto",FontSize = 14,FontStyle = "Bold",HTextAlign = "Center",Position = {5,4},Size = {panelWidth - 10,20}})
    table.insert(graphics,{Type = "GroupBox",Fill = White,StrokeColor = Border,StrokeWidth = 1,CornerRadius = 6,Position = {0,bodyTop},Size = {panelWidth,panelHeight}})
  
    -- Centered Seervision component picker
    local svLabelWidth = 150
    local svComboWidth = 260
    local svGap = 8
    local svBlockX = (panelWidth - (svLabelWidth + svGap + svComboWidth)) / 2
    table.insert(graphics,{Type = "Label",Text = "Seervision Component",Fill = Clear,Font = "Roboto",FontColor = Text,FontSize = 10,HTextAlign = "Right",Position = {svBlockX,toolbarY},Size = {svLabelWidth,18}})
    layout["sv_component"] = {PrettyName = "Status~Seervision Component",Style = "ComboBox",Fill = White,Font = "Roboto",FontSize = 11,FontColor = Black,Position = {svBlockX + svLabelWidth + svGap,toolbarY},Size = {svComboWidth,18}}
  
    table.insert(graphics,{Type = "GroupBox",Fill = Grey,StrokeWidth = 0,CornerRadius = 0,Position = {10,dividerY},Size = {panelWidth - 20,1}})
  
    -- Column headers
    local xEnable = 5
    local xTrigger = 49
    local xTargetComponent = 217
    local xTargetControl = 355
    local xProperty = 493
    local xValue = 576
    local xStatus = 654
    local xClear = 700

    table.insert(graphics,{Type = "Label",Text = "On",Fill = Clear,Font = "Roboto",FontStyle = "Bold",FontColor = Text,FontSize = 9,HTextAlign = "Center",Position = {xEnable,headerY},Size = {36,12}})
    table.insert(graphics,{Type = "Label",Text = "Trigger",Fill = Clear,Font = "Roboto",FontStyle = "Bold",FontColor = Text,FontSize = 9,HTextAlign = "Center",Position = {xTrigger,headerY},Size = {160,12}})
    table.insert(graphics,{Type = "Label",Text = "Target Component",Fill = Clear,Font = "Roboto",FontStyle = "Bold",FontColor = Text,FontSize = 9,HTextAlign = "Center",Position = {xTargetComponent,headerY},Size = {130,12}})
    table.insert(graphics,{Type = "Label",Text = "Target Control",Fill = Clear,Font = "Roboto",FontStyle = "Bold",FontColor = Text,FontSize = 9,HTextAlign = "Center",Position = {xTargetControl,headerY},Size = {130,12}})
    table.insert(graphics,{Type = "Label",Text = "Property",Fill = Clear,Font = "Roboto",FontStyle = "Bold",FontColor = Text,FontSize = 9,HTextAlign = "Center",Position = {xProperty,headerY},Size = {75,12}})
    table.insert(graphics,{Type = "Label",Text = "Value",Fill = Clear,Font = "Roboto",FontStyle = "Bold",FontColor = Text,FontSize = 9,HTextAlign = "Center",Position = {xValue,headerY},Size = {70,12}})
    table.insert(graphics,{Type = "Label",Text = "Status",Fill = Clear,Font = "Roboto",FontStyle = "Bold",FontColor = Text,FontSize = 9,HTextAlign = "Center",Position = {xStatus,headerY},Size = {40,12}})
    table.insert(graphics,{Type = "Label",Text = "Clear",Fill = Clear,Font = "Roboto",FontStyle = "Bold",FontColor = Text,FontSize = 9,HTextAlign = "Center",Position = {xClear,headerY},Size = {44,12}})

    for i = 1,ruleCount do
      local y = rowY + (i-1)*rowH
  
      layout["rule_enable_"..i] = {PrettyName = "Rules~Rule "..i.." Enable",Style = "Button",ButtonStyle = "Toggle",CornerRadius = 2,Margin = 2,Position = {xEnable,y+1},Size = {36,16}}
      layout["rule_trigger_"..i] = {PrettyName = "Rules~Rule "..i.." Trigger",Style = "ComboBox",Fill = White,Font = "Roboto",FontSize = 11,FontColor = Black,Position = {xTrigger,y},Size = {160,18}}
      layout["rule_target_component_"..i] = {PrettyName = "Rules~Rule "..i.." Target Component",Style = "ComboBox",Fill = White,Font = "Roboto",FontSize = 11,FontColor = Black,Position = {xTargetComponent,y},Size = {130,18}}
      layout["rule_target_control_"..i] = {PrettyName = "Rules~Rule "..i.." Target Control",Style = "ComboBox",Fill = White,Font = "Roboto",FontSize = 11,FontColor = Black,Position = {xTargetControl,y},Size = {130,18}}
      layout["rule_target_property_"..i] = {PrettyName = "Rules~Rule "..i.." Property",Style = "ComboBox",Fill = White,Font = "Roboto",FontSize = 11,FontColor = Black,Position = {xProperty,y},Size = {75,18}}
  
      -- Stacked value controls -- only one is visible at a time (toggled at runtime
      -- via IsInvisible depending on the selected property's type).
      layout["rule_target_value_bool_"..i] = {PrettyName = "Rules~Rule "..i.." Value (Boolean)",Style = "ComboBox",Fill = White,Font = "Roboto",FontSize = 11,FontColor = Black,Position = {xValue,y},Size = {70,18}}
      layout["rule_target_value_num_"..i] = {PrettyName = "Rules~Rule "..i.." Value (Number)",Style = "Text",Fill = White,Font = "Roboto",FontSize = 11,FontColor = Black,Position = {xValue,y},Size = {70,18}}
      layout["rule_target_value_str_"..i] = {PrettyName = "Rules~Rule "..i.." Value (String)",Style = "Text",Fill = White,Font = "Roboto",FontSize = 11,FontColor = Black,Position = {xValue,y},Size = {70,18}}
  
      layout["rule_status_"..i] = {PrettyName = "Rules~Rule "..i.." Status",Style = "Led",Color = {0,200,0},UnlinkOffColor = false,Position = {xStatus + 12,y+1},Size = {16,16}}
      layout["rule_clear_"..i] = {PrettyName = "Rules~Rule "..i.." Clear",Style = "Button",ButtonStyle = "Trigger",Legend = "Clear",FontSize = 9,CornerRadius = 2,Margin = 2,Position = {xClear,y+1},Size = {44,16}}
    end
  
  elseif CurrentPage == "Inspector" then
    local panelWidth = 450
    local bodyTop = 30
    local panelHeight = 490
  
    table.insert(graphics,{Type = "Header",Text = "Component Inspector",Color = Blue,Font = "Roboto",FontSize = 14,FontStyle = "Bold",HTextAlign = "Center",Position = {5,4},Size = {panelWidth - 10,20}})
    table.insert(graphics,{Type = "GroupBox",Fill = White,StrokeColor = Border,StrokeWidth = 1,CornerRadius = 6,Position = {0,bodyTop},Size = {panelWidth,panelHeight}})
  
    table.insert(graphics,{Type = "Label",Text = "Use this to browse any named component's controls -- e.g. to confirm Seervision's zone-triggered controls (matched by containing \"Triggered\") for regular and conductor cameras alike.",Fill = Clear,Font = "Roboto",FontColor = Text,FontSize = 9,Position = {10,bodyTop + 8},Size = {panelWidth - 20,28}})
  
    table.insert(graphics,{Type = "Label",Text = "Component",Fill = Clear,Font = "Roboto",FontColor = Text,FontSize = 10,HTextAlign = "Right",Position = {10,bodyTop + 42},Size = {80,18}})
    layout["inspect_component"] = {PrettyName = "Inspector~Component",Style = "ComboBox",Fill = White,Font = "Roboto",FontSize = 12,FontColor = Black,Position = {95,bodyTop + 42},Size = {230,18}}
  
    layout["inspect_output"] = {PrettyName = "Inspector~Controls",Style = "Text",Fill = White,Font = "Roboto",FontSize = 11,FontColor = Black,Position = {10,bodyTop + 66},Size = {panelWidth - 20,panelHeight - 76}}
  end
  return layout, graphics
end

-- Optional function to define components used within the plugin
function GetComponents(props)
  local components = {}
  -- This plugin has no internal sub-components -- it only talks outward to other
  -- named components via Component.New() at runtime.
  return components
end

-- Optional function to define pins on the plugin that are not connected to a Control
function GetPins(props)
  local pins = {}
  -- No external audio/serial pins are needed for this plugin.
  return pins
end

-- Optional function to define wiring of components used within the plugin
function GetWiring(props)
  local wiring = {}
  -- No internal components to wire (see GetComponents).
  return wiring
end

-- Start event based logic
if Controls then
  -- Seervision Trigger Mapper -- runtime logic
  --
  -- Binds to a Seervision named component (chosen from a dropdown filtered to
  -- that plugin's Type), discovers its zone-triggered controls, and lets each
  -- rule row forward that trigger onto a property of any other named
  -- component/control in the design. Several rules may share one trigger;
  -- they all fire, in rule order, whenever it goes true.

  RuleCount = Properties["Rule Count"].Value
  SVPlugin = nil
  SVName = nil
  SVBound = false
  TriggerChoices = {"none"}

  -- trigger control name -> list of rule indices listening on it. Rebuilt
  -- from the rule rows by RewireTriggers(), never edited incrementally, so it
  -- always matches what the UI shows.
  TriggerMap = {}

  -- trigger control name -> the Seervision control object currently carrying
  -- our dispatcher, so it can be unhooked once no rule references it.
  HookedTriggers = {}
  
  -- The Seervision/VisionSuite plugin's own Type string, as reported by
  -- Component.GetComponents() -- this is how sv_component's dropdown is
  -- filtered down to just Seervision instances instead of every component in
  -- the design.
  SV_PLUGIN_TYPE = "%PLUGIN%_b26588a3-524c-4809-a7c2-9c31d9cda097_%FP%_a2fd6c6c6e0650e986935f1af43ea354"
  
  -- Any control on the bound Seervision component whose name contains this
  -- substring is offered as a trigger source -- this is what sweeps up every
  -- camera's (and every conductor camera's) zone-triggered controls without
  -- needing to know their exact naming scheme in advance.
  TRIGGER_CONTROL_PATTERN = "Triggered"
  
  PROPERTY_CHOICES_BY_TYPE = {
    Boolean = {"Boolean"},
    Float   = {"Value","Position"},
    Integer = {"Value","Position"},
    Text    = {"String"},
    Trigger = {"Trigger"},
  }
  DEFAULT_PROPERTY_CHOICES = {"Value","String"}
  BOOL_CHOICES = {"true","false"}
  
  --- Keeps `current` if it's still present in `choices`, otherwise falls back
  --- to the first choice -- this is what stops a recompile/reload (which
  --- re-runs Initialize() and rebuilds every dropdown's Choices) from
  --- snapping already-configured rows back to their first option.
  function PreserveOrDefault(current, choices)
    for _,c in ipairs(choices) do
      if c == current then return current end
    end
    return choices[1]
  end
  
  --- Returns the control descriptor table for a named control on a named
  --- component, or nil if the component/control can't be read right now.
  function GetControlDescriptor(componentName, controlName)
    local ok, ctrls = pcall(Component.GetControls, componentName)
    if not ok or not ctrls then return nil end
    for _,c in ipairs(ctrls) do
      if c.Name == controlName then return c end
    end
    return nil
  end
  
  --- Refreshes sv_component's dropdown with every named component in the
  --- design whose Type matches the Seervision plugin, keeping the current
  --- selection if it's still one of them.
  function RefreshSVComponentChoices()
    local choices = {"none"}
    local ok, comps = pcall(Component.GetComponents)
    if ok and comps then
      local names = {}
      for _,c in ipairs(comps) do
        if c.Type == SV_PLUGIN_TYPE then
          table.insert(names, c.Name)
        end
      end
      table.sort(names)
      for _,n in ipairs(names) do table.insert(choices, n) end
    end
    Controls.sv_component.Choices = choices
    Controls.sv_component.String = PreserveOrDefault(Controls.sv_component.String, choices)
  end
  
  --- Binds SVPlugin to the component selected in sv_component. Does nothing
  --- if that component is already bound, so the periodic rescan doesn't
  --- create a fresh Component.New proxy (and a fresh set of handlers) every
  --- tick. Switching components unhooks every trigger on the old one first.
  function BindSeervision()
    local name = Controls.sv_component.String
    if SVBound and name == SVName then return end

    UnhookAllTriggers()
    SVBound = false
    SVPlugin = nil
    SVName = name
    if name ~= "none" and name ~= "" then
      local ok, comp = pcall(Component.New, name)
      if ok and comp then
        SVPlugin = comp
        SVBound = true
      end
    end
  end

  --- Scans SVPlugin's controls for names matching TRIGGER_CONTROL_PATTERN
  --- (e.g. "Triggered") and populates every rule row's trigger dropdown with
  --- the real control names -- this is what sweeps up every camera's (and
  --- every conductor camera's) zone-triggered controls without needing to know
  --- their exact naming scheme in advance. "none" is always offered first so
  --- a row can be unhooked.
  function RefreshTriggerChoices()
    local names = {}

    if SVBound then
      local ok, ctrls = pcall(Component.GetControls, SVName)
      if ok and ctrls then
        for _,c in ipairs(ctrls) do
          if string.find(c.Name, TRIGGER_CONTROL_PATTERN) then
            table.insert(names, c.Name)
          end
        end
      end
    end

    table.sort(names)
    table.insert(names, 1, "none")
    TriggerChoices = names

    for i = 1,RuleCount do
      Controls["rule_trigger_"..i].Choices = TriggerChoices
      -- While unbound, leave saved selections alone rather than resetting
      -- every row to "none" and losing its configuration.
      if SVBound then
        Controls["rule_trigger_"..i].String = PreserveOrDefault(Controls["rule_trigger_"..i].String, TriggerChoices)
      end
    end
    RewireTriggers()
  end
  
  --- Refreshes the list of every named component in the design (minus "none")
  --- onto every rule row's target-component dropdown and the Inspector.
  function RefreshNamedComponents()
    local choices = {"none"}
    local ok, comps = pcall(Component.GetComponents)
    if ok and comps then
      local names = {}
      for _,c in ipairs(comps) do table.insert(names, c.Name) end
      table.sort(names)
      for _,n in ipairs(names) do table.insert(choices, n) end
    end
  
    Controls.inspect_component.Choices = choices
    for i = 1,RuleCount do
      Controls["rule_target_component_"..i].Choices = choices
    end
  end
  
  --- Rebuilds a rule row's target-control dropdown from the currently selected
  --- target component, then cascades into OnTargetControlChanged.
  function OnTargetComponentChanged(i)
    local compName = Controls["rule_target_component_"..i].String
    local choices = {"none"}
    if compName ~= "none" and compName ~= "" then
      local ok, ctrls = pcall(Component.GetControls, compName)
      if ok and ctrls then
        local names = {}
        for _,c in ipairs(ctrls) do
          if c.Direction ~= "Read Only" then
            table.insert(names, c.Name)
          end
        end
        table.sort(names)
        if #names > 0 then choices = names end
      end
    end
    Controls["rule_target_control_"..i].Choices = choices
    Controls["rule_target_control_"..i].String = PreserveOrDefault(Controls["rule_target_control_"..i].String, choices)
    OnTargetControlChanged(i)
  end
  
  --- Rebuilds a rule row's property dropdown to match the selected target
  --- control's data type, then updates which value-entry control is visible.
  function OnTargetControlChanged(i)
    local compName = Controls["rule_target_component_"..i].String
    local ctrlName = Controls["rule_target_control_"..i].String
    local propCombo = Controls["rule_target_property_"..i]
  
    local choices = DEFAULT_PROPERTY_CHOICES
    if compName ~= "none" and ctrlName ~= "none" and ctrlName ~= "" then
      local desc = GetControlDescriptor(compName, ctrlName)
      if desc and PROPERTY_CHOICES_BY_TYPE[desc.Type] then
        choices = PROPERTY_CHOICES_BY_TYPE[desc.Type]
      end
    end
    propCombo.Choices = choices
    propCombo.String = PreserveOrDefault(propCombo.String, choices)
    UpdateValueControlVisibility(i)
  end
  
  --- Shows only the value-entry control that matches the row's currently
  --- selected property (Boolean / Value+Position / String); Trigger properties
  --- need no value entry at all since ApplyRule just calls target:Trigger().
  function UpdateValueControlVisibility(i)
    local prop = Controls["rule_target_property_"..i].String
    local boolCombo = Controls["rule_target_value_bool_"..i]
    boolCombo.Choices = BOOL_CHOICES
    boolCombo.IsInvisible = (prop ~= "Boolean")
    Controls["rule_target_value_num_"..i].IsInvisible = not (prop == "Value" or prop == "Position")
    Controls["rule_target_value_str_"..i].IsInvisible = (prop ~= "String")
  end
  
  --- Builds trigger control name -> {rule indices} from the rule rows'
  --- current Trigger selections.
  function BuildTriggerMap()
    local map = {}
    for i = 1,RuleCount do
      local name = Controls["rule_trigger_"..i].String
      if name and name ~= "none" and name ~= "" then
        map[name] = map[name] or {}
        table.insert(map[name], i)
      end
    end
    return map
  end

  --- Removes our dispatcher from every Seervision control we've hooked.
  function UnhookAllTriggers()
    for _,ctrl in pairs(HookedTriggers) do
      ctrl.EventHandler = nil
    end
    HookedTriggers = {}
  end

  --- Brings the Seervision hooks in line with the rule rows: one dispatcher
  --- per referenced trigger control, which runs every rule listed against it
  --- in TriggerMap at the moment it fires. Controls no rule references any
  --- more are unhooked. Safe to call repeatedly -- already-hooked controls
  --- are left as they are.
  function RewireTriggers()
    TriggerMap = BuildTriggerMap()

    for name,ctrl in pairs(HookedTriggers) do
      if not TriggerMap[name] then
        ctrl.EventHandler = nil
        HookedTriggers[name] = nil
      end
    end

    if not SVBound then return end
    for name,_ in pairs(TriggerMap) do
      if not HookedTriggers[name] then
        local ok, ctrl = pcall(function() return SVPlugin[name] end)
        if ok and ctrl then
          ctrl.EventHandler = function(c)
            if not c.Boolean then return end
            for _,i in ipairs(TriggerMap[name] or {}) do ApplyRule(i) end
          end
          HookedTriggers[name] = ctrl
        end
      end
    end
  end

  --- Resets a rule row to its defaults (disabled, no trigger, no target),
  --- which also removes its action from the trigger it was stacked on.
  function ClearRule(i)
    Controls["rule_enable_"..i].Boolean = false
    Controls["rule_trigger_"..i].String = "none"
    Controls["rule_target_component_"..i].String = "none"
    Controls["rule_target_control_"..i].String = "none"
    Controls["rule_target_value_bool_"..i].String = "false"
    Controls["rule_target_value_num_"..i].String = "0"
    Controls["rule_target_value_str_"..i].String = ""
    OnTargetComponentChanged(i)
    RefreshRuleStatus(i)
    RewireTriggers()
  end
  
  --- Sets a rule row's status LED to reflect its enabled state, without
  --- touching the target control -- this is what rule_enable_i's EventHandler
  --- calls, so flipping "On" just arms/disarms the rule instead of firing it.
  function RefreshRuleStatus(i)
    local status = Controls["rule_status_"..i]
    if Controls["rule_enable_"..i].Boolean then
      status.Value = 0
      status.String = ""
    else
      status.Value = 4
      status.String = "Disabled"
    end
  end
  
  --- Applies a rule row's configured value to its target control. Reports
  --- success/failure on the row's status LED rather than raising -- a missing
  --- or renamed target must not take down the rest of the plugin. Only ever
  --- called from the live Seervision trigger's EventHandler (see RewireTriggers)
  --- -- never from rule_enable_i, which should arm/disarm without firing.
  function ApplyRule(i)
    local status = Controls["rule_status_"..i]
  
    if not Controls["rule_enable_"..i].Boolean then
      status.Value = 4
      status.String = "Disabled"
      return
    end
  
    local compName = Controls["rule_target_component_"..i].String
    local ctrlName = Controls["rule_target_control_"..i].String
    local prop = Controls["rule_target_property_"..i].String
  
    if compName == "none" or ctrlName == "none" or ctrlName == "" then
      status.Value = 2
      status.String = "No target selected"
      return
    end
  
    -- Both the component lookup and the control index can raise, so keep
    -- them inside the pcall.
    local ok, target = pcall(function() return Component.New(compName)[ctrlName] end)
    if not ok or not target then
      status.Value = 2
      status.String = "Target component/control not found"
      return
    end
  
    local applyOk, err = pcall(function()
      if prop == "Boolean" then
        target.Boolean = (Controls["rule_target_value_bool_"..i].String == "true")
      elseif prop == "Trigger" then
        target:Trigger()
      elseif prop == "Value" then
        target.Value = tonumber(Controls["rule_target_value_num_"..i].String) or 0
      elseif prop == "Position" then
        target.Position = tonumber(Controls["rule_target_value_num_"..i].String) or 0
      elseif prop == "String" then
        target.String = Controls["rule_target_value_str_"..i].String
      end
    end)
  
    if applyOk then
      status.Value = 0
      status.String = ""
    else
      status.Value = 2
      status.String = "Apply failed: "..tostring(err)
    end
  end
  
  --- Fills the Inspector page with every control's Name/Type/Direction for the
  --- selected component -- this is how you read Seervision's real zone control
  --- names off a live design to confirm TRIGGER_CONTROL_PATTERN matches them.
  function DumpInspector()
    local compName = Controls.inspect_component.String
    if compName == "none" or compName == "" then
      Controls.inspect_output.String = ""
      return
    end
    local ok, ctrls = pcall(Component.GetControls, compName)
    if not ok or not ctrls then
      Controls.inspect_output.String = "Could not read controls for "..compName
      return
    end
    table.sort(ctrls, function(a,b) return a.Name < b.Name end)
    local lines = {}
    for _,c in ipairs(ctrls) do
      table.insert(lines, string.format("%s  [%s, %s]", c.Name, tostring(c.Type), tostring(c.Direction)))
    end
    Controls.inspect_output.String = table.concat(lines, "\n")
  end
  
  function EventHandlers()
    Controls.sv_component.EventHandler = function()
      BindSeervision()
      RefreshTriggerChoices()
    end
    Controls.inspect_component.EventHandler = function() DumpInspector() end

    for i = 1,RuleCount do
      Controls["rule_target_component_"..i].EventHandler = function() OnTargetComponentChanged(i) end
      Controls["rule_target_control_"..i].EventHandler = function() OnTargetControlChanged(i) end
      Controls["rule_target_property_"..i].EventHandler = function() UpdateValueControlVisibility(i) end
      Controls["rule_trigger_"..i].EventHandler = function() RewireTriggers() end
      Controls["rule_enable_"..i].EventHandler = function() RefreshRuleStatus(i) end
      Controls["rule_clear_"..i].EventHandler = function() ClearRule(i) end
    end
  end

  function Initialize()
    RefreshSVComponentChoices()
    BindSeervision()
    RefreshTriggerChoices() -- also wires every referenced trigger
    RefreshNamedComponents()
    for i = 1,RuleCount do
      OnTargetComponentChanged(i)
      RefreshRuleStatus(i)
    end
  end

  EventHandlers()
  Initialize()

  -- Periodically re-scan, in case components/controls are added, removed or
  -- renamed while the design is running. Timer:Start() repeats on its own
  -- interval until Stop(), so it only needs starting once.
  RefreshTimer = Timer.New()
  RefreshTimer.EventHandler = function()
    RefreshSVComponentChoices()
    BindSeervision()
    RefreshTriggerChoices()
    RefreshNamedComponents()
  end
  RefreshTimer:Start(10)
end
